# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# HubSpot API Configuration
# Get your API key from: https://app.hubspot.com/settings/account/api-key
# Or use Private App access token: https://developers.hubspot.com/docs/api/private-apps
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-access-token

# Database
DATABASE_PATH=./data/cpq.db

# Company Information (for quotes)
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=123 Business Street, City, State 12345
COMPANY_PHONE=(555) 123-4567
COMPANY_EMAIL=sales@yourcompany.com
COMPANY_WEBSITE=https://yourcompany.com
